# Required server-side Enneo authentication. Never expose this value to the browser.
ENNEO_API_TOKEN=replace-with-an-enneo-api-token

# Optional. Defaults target the dedicated aleksa-dev outbound line.
ENNEO_OUTBOUND_URL=https://aleksa-dev.enneo.ai/api/mind/telephony/outboundCall
OUTBOUND_SUBCHANNEL_ID=12

# Required. Calls are blocked unless the submitted token matches this value.
DEMO_ACCESS_TOKEN=replace-with-a-long-random-demo-token

# Optional comma-separated allowlist. Leave empty for any valid E.164 number.
# Recommended before public demos.
ALLOWED_PHONE_NUMBERS=+491607763741
